### 2-1. 운전자 1: 60km 운행, 깜빡이 켬(리그 점수 100) → 201 SCORED
POST {{host}}/api/trips
Authorization: Bearer {{busan1Token}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "{{tripStart}}",
  "endedAt": "{{tripEnd}}",
  "distanceKm": 60.0,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{tripTurn}}",
      "payload": { "direction": "LEFT", "signalOn": true } }
  ]
}

> {%
    client.test("201 SCORED", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
%}

