### 3. 운전자 1의 리그 → 200, 부산 리그 순위 공개(참여자 10명 이상), 안전지수 90.0, 내 순위 1위
# 안전지수 = (100 × 60 × 9 + 0 × 60) ÷ 600 = 90.0(포인트 미포함).
# 순위 점수 = 평균 100 + 운행 포인트 50P(최대 50km × 100점 ÷ 100) = 150. 9명이 150점으로 공동 1위, 0점(포인트 0)은 10위.
GET {{host}}/api/leagues/current
Authorization: Bearer {{busan1Token}}

> {%
    client.test("200 부산 리그", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var league = response.body.league;
        client.assert(league.leagueCode === "BUSAN", "leagueCode: " + league.leagueCode);
        client.assert(league.participants >= 10, "participants: " + league.participants);
        client.assert(league.rankingPublished === true, "rankingPublished: " + league.rankingPublished);
        client.assert(league.safetyIndex === 90, "safetyIndex: " + league.safetyIndex);
        client.assert(league.rankings.length === 10, "rankings: " + league.rankings.length);
        var first = league.rankings[0];
        client.assert(first.rank === 1 && first.averageScore === 100 && first.points === 50 && first.score === 150, "1위: " + JSON.stringify(first));
        // 서버를 새로 띄운 뒤 처음 실행하면 참여자가 10명이라 0점 운전자가 10위다(다시 실행하면 150점 운전자가 늘어 확인하지 않는다).
        if (league.participants === 10) {
            var last = league.rankings[9];
            client.assert(last.rank === 10 && last.averageScore === 0 && last.points === 0 && last.score === 0, "10위: " + JSON.stringify(last));
        }
    });
    client.test("내 기록: 공개 · 자격 있음(60km) · 평균 100 + 50P = 150점 · 1위 · 우승 칭호 없음", function () {
        var me = response.body.me;
        client.assert(me.visible === true, "visible: " + me.visible);
        client.assert(me.eligible === true, "eligible: " + me.eligible);
        client.assert(me.averageScore === 100 && me.points === 50 && me.score === 150, "score: " + me.averageScore + " + " + me.points + " = " + me.score);
        client.assert(Array.isArray(me.championships) && me.championships.length === 0, "championships: " + JSON.stringify(me.championships));
        client.assert(me.rank === 1, "rank: " + me.rank);
        client.assert(me.trips === 1 && me.distanceKm === 60, "trips/distance: " + me.trips + "/" + me.distanceKm);
    });
    client.test("시즌 기간과 월드맵 권역 목록(21개)", function () {
        var season = response.body.season;
        client.assert(/^\d{4}-\d{2}$/.test(season.seasonId), "seasonId: " + season.seasonId);
        client.assert(season.startsAt.endsWith("-01T00:00:00+09:00"), "startsAt: " + season.startsAt);
        client.assert(response.body.regions.length === 21, "regions: " + response.body.regions.length);
        var busan = response.body.regions.filter(function (r) { return r.leagueCode === "BUSAN"; })[0];
        client.assert(busan.safetyIndex === 90, "BUSAN safetyIndex: " + busan.safetyIndex);
    });
%}

### 4. 운전자 1이 리그 순위 공개를 끔 → 200 visible=false (D8)
PUT {{host}}/api/drivers/me/league-visibility
Authorization: Bearer {{busan1Token}}
Content-Type: application/json

{ "visible": false }

> {%
    client.test("200 visible=false", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.visible === false, "visible: " + response.body.visible);
    });
%}

### 5. 운전자 1의 리그 → 내 순위 없음(공개를 끔), 점수는 본인에게만 보임
GET {{host}}/api/leagues/current
Authorization: Bearer {{busan1Token}}

> {%
    client.test("200 visible=false, rank=null", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.me.visible === false, "visible: " + response.body.me.visible);
        client.assert(response.body.me.rank === null, "rank: " + response.body.me.rank);
        client.assert(response.body.me.score === 150, "score: " + response.body.me.score);
    });
%}

### 6. 운전자 2의 리그 → 순위는 계속 공개, 운전자 1만 순위 목록에서 빠지고 운전자 2는 1위(D8)
# 운전자 1은 참여자 수(10명)에는 남아 순위가 비공개되지 않는다. 나머지 운전자끼리 순위를 매긴다.
GET {{host}}/api/leagues/current
Authorization: Bearer {{busan2Token}}

> {%
    client.test("200 순위 공개 유지, 운전자 1 제외", function () {
        client.assert(response.status === 200, "status: " + response.status);
        var league = response.body.league;
        client.assert(league.participants >= 10, "participants: " + league.participants);
        client.assert(league.rankingPublished === true, "rankingPublished: " + league.rankingPublished);
        var hiddenName = client.global.get("busan1Nickname");
        var names = league.rankings.map(function (r) { return r.nickname; });
        client.assert(names.indexOf(hiddenName) === -1, "운전자 1이 순위에 있음: " + JSON.stringify(names));
        client.assert(response.body.me.rank === 1, "rank: " + response.body.me.rank);
    });
%}

### 7. 운전자 1이 순위 공개를 다시 켬 → 200 visible=true
PUT {{host}}/api/drivers/me/league-visibility
Authorization: Bearer {{busan1Token}}
Content-Type: application/json

{ "visible": true }

> {%
    client.test("200 visible=true", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.visible === true, "visible: " + response.body.visible);
    });
%}

### 8. visible 누락 → 400 INVALID_INPUT
PUT {{host}}/api/drivers/me/league-visibility
Authorization: Bearer {{busan1Token}}
Content-Type: application/json

{}

> {%
    client.test("400 INVALID_INPUT", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.code === "INVALID_INPUT", "code: " + response.body.code);
    });
%}

### 9. 매핑표에 없는 지역(99999) 운전자 등록 → 201
POST {{host}}/api/drivers
Content-Type: application/json

{
  "nickname": "무소속{{$randomInt}}",
  "regionCode": "99999"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "status: " + response.status);
    });
    client.global.set("noLeagueToken", response.body.accessToken);
%}

### 10. 매핑표에 없는 지역 운전자의 리그 → 200, league=null, 순위 없음
GET {{host}}/api/leagues/current
Authorization: Bearer {{noLeagueToken}}

> {%
    client.test("200 league=null", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.league === null, "league: " + JSON.stringify(response.body.league));
        client.assert(response.body.me.rank === null, "rank: " + response.body.me.rank);
    });
%}

### 11. 토큰 없이 리그 조회 → 401 UNAUTHORIZED
GET {{host}}/api/leagues/current

> {%
    client.test("401 UNAUTHORIZED", function () {
        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.code === "UNAUTHORIZED", "code: " + response.body.code);
    });
%}
