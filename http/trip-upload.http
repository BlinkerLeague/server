### 18 · 19. 이벤트 2,001개 → 400 INVALID_INPUT, 본문 1MB 초과 → 413 PAYLOAD_TOO_LARGE (D16)
# 요청이 너무 커서 이 파일에 적지 않는다. 아래 스크립트로 확인한다(서버 실행 중, Git Bash).
#   TOKEN=<0-A의 accessToken>
#   python -c "import json,uuid,datetime as d;k=d.timezone(d.timedelta(hours=9));n=d.datetime.now(k);s=n-d.timedelta(hours=1);e=n-d.timedelta(minutes=1);print(json.dumps({'tripId':str(uuid.uuid4()),'startedAt':s.isoformat(timespec='seconds'),'endedAt':e.isoformat(timespec='seconds'),'distanceKm':30,'supported':['SMOOTH_DRIVING'],'events':[{'eventId':str(uuid.uuid4()),'type':'HARSH_BRAKE','occurredAt':(s+d.timedelta(seconds=1+i)).isoformat(timespec='seconds')} for i in range(2001)]}))" > e2001.json
#   curl -s -X POST http://localhost:8080/api/trips -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data-binary @e2001.json
#     → 400 {"code":"INVALID_INPUT", ...} (range(2000)이면 201)
#   python -c "print('{\"memo\":\"' + 'x' * 1100000 + '\"}')" > big.json
#   curl -s -X POST http://localhost:8080/api/trips -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data-binary @big.json
#     → 413 {"code":"PAYLOAD_TOO_LARGE", ...} (-H "Transfer-Encoding: chunked"를 붙여도 413)
