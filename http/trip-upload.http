### 운행 업로드 API 로컬 수동 테스트 (IntelliJ HTTP Client)
# 준비: docker compose up -d (Redis), .env에 JWT_SECRET 설정, ./gradlew bootRun
# 환경: 실행 시 http-client.env.json의 "local"을 고른다.
# 위에서부터 순서대로 실행한다. 0-A, 0-B에서 받은 토큰 · 날짜와 1번의 tripId를 다음 요청이 이어받는다.
# 운행 날짜는 0-A가 계산한 어제 날짜다(D17: 7일보다 오래되거나 5분 넘게 미래인 운행은 400).
# 저장 결과는 http://localhost:8080/h2-console 에서 확인한다.
#   JDBC URL: jdbc:h2:mem:blinkerleague, 사용자: sa, 비밀번호 없음
#   select * from trip;  select * from trip_event;
# H2는 인메모리라 서버를 재시작하면 데이터가 사라진다. 그때는 0번부터 다시 실행한다.
# tripId · eventId는 매번 새 UUID라 몇 번을 다시 실행해도 서로 겹치지 않는다.

### 0-A. 운전자 A 등록 → 201 (A의 accessToken 저장)
POST {{host}}/api/drivers
Content-Type: application/json

{
  "nickname": "운행A{{$randomInt}}",
  "regionCode": "11440"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "status: " + response.status);
    });
    client.global.set("driverAToken", response.body.accessToken);
    // 운행 시각 허용 범위(D17: 미래 5분 · 과거 7일) 때문에 날짜를 고정하지 않는다. 한국 시간(UTC+9) 기준 어제 날짜를 쓴다.
    var kstNow = new Date(Date.now() + 9 * 60 * 60 * 1000);
    var kstYesterday = new Date(kstNow.getTime() - 24 * 60 * 60 * 1000);
    client.global.set("yesterday", kstYesterday.toISOString().substring(0, 10));
    // 16 · 17번용: 지금 + 10분(미래), 지금 − 8일(7일 초과)을 +09:00 형식으로
    function kst(ms) { return new Date(ms + 9 * 60 * 60 * 1000).toISOString().substring(0, 19) + "+09:00"; }
    client.global.set("futureStart", kst(Date.now() - 20 * 60 * 1000));
    client.global.set("futureEnd", kst(Date.now() + 10 * 60 * 1000));
    client.global.set("oldStart", kst(Date.now() - 8 * 24 * 60 * 60 * 1000));
    client.global.set("oldEnd", kst(Date.now() - 8 * 24 * 60 * 60 * 1000 + 30 * 60 * 1000));
%}

### 0-B. 운전자 B 등록 → 201 (B의 accessToken 저장, 3번 409 확인용)
POST {{host}}/api/drivers
Content-Type: application/json

{
  "nickname": "운행B{{$randomInt}}",
  "regionCode": "11440"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "status: " + response.status);
    });
    client.global.set("driverBToken", response.body.accessToken);
%}

### 1. 정상 업로드(12.3km) → 201 + SCORED (점수 계산까지, tripId 저장)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "{{yesterday}}T08:00:00+09:00",
  "endedAt": "{{yesterday}}T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{yesterday}}T08:12:30+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{yesterday}}T08:20:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": false } }
  ]
}

> {%
    client.test("201 SCORED", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
    client.global.set("tripId", response.body.tripId);
%}

### 2. 같은 tripId 재전송(거리를 1.0으로 바꿔도) → 200 + 처음 저장한 결과(SCORED) 그대로
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "startedAt": "{{yesterday}}T08:00:00+09:00",
  "endedAt": "{{yesterday}}T08:40:00+09:00",
  "distanceKm": 1.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("200 기존 결과", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.tripId === client.global.get("tripId"), "tripId: " + response.body.tripId);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
%}

### 3. 다른 운전자(B)가 A의 tripId로 업로드 → 409 CONFLICT
POST {{host}}/api/trips
Authorization: Bearer {{driverBToken}}
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "startedAt": "{{yesterday}}T08:00:00+09:00",
  "endedAt": "{{yesterday}}T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("409 CONFLICT", function () {
        client.assert(response.status === 409, "status: " + response.status);
        client.assert(response.body.code === "CONFLICT", "code: " + response.body.code);
    });
%}

