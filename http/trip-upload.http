### 운행 업로드 API 로컬 수동 테스트 (IntelliJ HTTP Client)
# 준비: docker compose up -d (Redis), .env에 JWT_SECRET 설정, ./gradlew bootRun
# 환경: 실행 시 http-client.env.json의 "local"을 고른다.
# 위에서부터 순서대로 실행한다. 0-A, 0-B에서 받은 토큰과 1번의 tripId를 다음 요청이 이어받는다.
# 저장 결과는 http://localhost:8080/h2-console 에서 확인한다.
#   JDBC URL: jdbc:h2:mem:blinkerleague, 사용자: sa, 비밀번호 없음
#   select * from trip;  select * from trip_event;
# H2는 인메모리라 서버를 재시작하면 데이터가 사라진다. 그때는 0번부터 다시 실행한다.
# tripId · eventId는 매번 새 UUID라 몇 번을 다시 실행해도 서로 겹치지 않는다.

### 0-A. 운전자 A 등록 → 201 (A의 accessToken 저장)
POST {{host}}/api/drivers
Content-Type: application/json

{
  "nickname": "운행A{{$randomInt}}",
  "regionCode": "11440"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "status: " + response.status);
    });
    client.global.set("driverAToken", response.body.accessToken);
%}

### 0-B. 운전자 B 등록 → 201 (B의 accessToken 저장, 3번 409 확인용)
POST {{host}}/api/drivers
Content-Type: application/json

{
  "nickname": "운행B{{$randomInt}}",
  "regionCode": "11440"
}

> {%
    client.test("201 Created", function () {
        client.assert(response.status === 201, "status: " + response.status);
    });
    client.global.set("driverBToken", response.body.accessToken);
%}

### 1. 정상 업로드(12.3km) → 201 + SCORED (점수 계산까지, tripId 저장)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "2026-11-03T08:12:30+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "2026-11-03T08:20:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": false } }
  ]
}

> {%
    client.test("201 SCORED", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
    client.global.set("tripId", response.body.tripId);
%}

### 2. 같은 tripId 재전송(거리를 1.0으로 바꿔도) → 200 + 처음 저장한 결과(SCORED) 그대로
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 1.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("200 기존 결과", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.tripId === client.global.get("tripId"), "tripId: " + response.body.tripId);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
%}

### 3. 다른 운전자(B)가 A의 tripId로 업로드 → 409 CONFLICT
POST {{host}}/api/trips
Authorization: Bearer {{driverBToken}}
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("409 CONFLICT", function () {
        client.assert(response.status === 409, "status: " + response.status);
        client.assert(response.body.code === "CONFLICT", "code: " + response.body.code);
    });
%}

### 4. 최소 거리 1km 미만(0.9km) → 201 + EXCLUDED_SHORT (D10)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T09:00:00+09:00",
  "endedAt": "2026-11-03T09:10:00+09:00",
  "distanceKm": 0.9,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "2026-11-03T09:05:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } }
  ]
}

> {%
    client.test("201 EXCLUDED_SHORT", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "EXCLUDED_SHORT", "status: " + response.body.status);
    });
%}

### 5. 정확히 1.0km → 201 + NO_TURN (경계값은 참여. 이벤트가 없어 측정 항목 없음, D28)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T09:00:00+09:00",
  "endedAt": "2026-11-03T09:10:00+09:00",
  "distanceKm": 1.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("201 NO_TURN", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "NO_TURN", "status: " + response.body.status);
    });
%}

### 6. 회전 0회(이벤트 없음) → 201 + NO_TURN (최소 회전 수 없음, D10. 측정할 항목이 없으면 NO_TURN, D28)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T10:00:00+09:00",
  "endedAt": "2026-11-03T10:30:00+09:00",
  "distanceKm": 15.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("201 NO_TURN", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "NO_TURN", "status: " + response.body.status);
    });
%}

### 7. 차선 변경 · 기타 이벤트도 저장(점수 반영은 P1, D14). 시작 · 종료 시각과 같은 이벤트도 허용 → 201 + SCORED
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T11:00:00+09:00",
  "endedAt": "2026-11-03T11:30:00+09:00",
  "distanceKm": 8.0,
  "supported": ["TURN_SIGNAL", "SMOOTH_DRIVING"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "LANE_CHANGE", "occurredAt": "2026-11-03T11:00:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "HARSH_BRAKE", "occurredAt": "2026-11-03T11:15:00+09:00" },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "2026-11-03T11:30:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": true } }
  ]
}

> {%
    client.test("201 SCORED", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
%}

### 8. 토큰 없이 업로드 → 401 UNAUTHORIZED
POST {{host}}/api/trips
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("401 UNAUTHORIZED", function () {
        client.assert(response.status === 401, "status: " + response.status);
        client.assert(response.body.code === "UNAUTHORIZED", "code: " + response.body.code);
    });
%}

### 9. 종료 시각 = 시작 시각 → 400 INVALID_INPUT
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:00:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("400 INVALID_INPUT", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.code === "INVALID_INPUT", "code: " + response.body.code);
    });
%}

### 10. 운행 종료 1초 뒤의 이벤트 → 400 INVALID_INPUT
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "2026-11-03T08:40:01+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } }
  ]
}

> {%
    client.test("400 INVALID_INPUT", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.code === "INVALID_INPUT", "code: " + response.body.code);
    });
%}

### 11. 한 요청 안에 같은 eventId 두 번 → 400 INVALID_INPUT (저장 전에 거부하므로 고정 ID를 써도 안전)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "2026-11-03T08:00:00+09:00",
  "endedAt": "2026-11-03T08:40:00+09:00",
  "distanceKm": 12.3,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "duplicate-event", "type": "TURN", "occurredAt": "2026-11-03T08:10:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "duplicate-event", "type": "TURN", "occurredAt": "2026-11-03T08:20:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": true } }
  ]
}

> {%
    client.test("400 INVALID_INPUT", function () {
        client.assert(response.status === 400, "status: " + response.status);
        client.assert(response.body.code === "INVALID_INPUT", "code: " + response.body.code);
    });
%}

