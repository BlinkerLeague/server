  "tripId": "{{$uuid}}",
  "startedAt": "{{yesterday}}T09:00:00+09:00",
  "endedAt": "{{yesterday}}T09:10:00+09:00",
  "distanceKm": 1.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("201 NO_TURN", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "NO_TURN", "status: " + response.body.status);
    });
%}

### 6. 회전 0회(이벤트 없음) → 201 + NO_TURN (최소 회전 수 없음, D10. 측정할 항목이 없으면 NO_TURN, D28)
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "{{yesterday}}T10:00:00+09:00",
  "endedAt": "{{yesterday}}T10:30:00+09:00",
  "distanceKm": 15.0,
  "supported": ["TURN_SIGNAL"],
  "events": []
}

> {%
    client.test("201 NO_TURN", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "NO_TURN", "status: " + response.body.status);
    });
%}

### 7. 차선 변경 · 기타 이벤트도 저장(점수 반영은 P1, D14). 시작 · 종료 시각과 같은 이벤트도 허용 → 201 + SCORED
POST {{host}}/api/trips
Authorization: Bearer {{driverAToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "{{yesterday}}T11:00:00+09:00",
  "endedAt": "{{yesterday}}T11:30:00+09:00",
  "distanceKm": 8.0,
  "supported": ["TURN_SIGNAL", "SMOOTH_DRIVING"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "LANE_CHANGE", "occurredAt": "{{yesterday}}T11:00:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "HARSH_BRAKE", "occurredAt": "{{yesterday}}T11:15:00+09:00" },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{yesterday}}T11:30:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": true } }
  ]
}

> {%
    client.test("201 SCORED", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "SCORED", "status: " + response.body.status);
    });
%}

