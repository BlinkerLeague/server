    });
%}

### 7. 3라운드 달성 → ACHIEVED, 진행도 3/3 · 100%
GET {{host}}/api/missions/today
Authorization: Bearer {{missionAToken}}

> {%
    client.test("200 ACHIEVED", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "ACHIEVED", "status: " + response.body.status);
        client.assert(response.body.progress.turns === 3, "turns: " + response.body.progress.turns);
        client.assert(response.body.progress.successTurns === 3, "successTurns: " + response.body.progress.successTurns);
        client.assert(response.body.conditions[1].current === 100, "signalRate: " + response.body.conditions[1].current);
    });
%}

