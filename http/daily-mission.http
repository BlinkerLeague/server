### 10-B. B: 오늘 2.9km 운행에서 회전 3회 성공 → 201 EXCLUDED_SHORT (3km 미만은 미션 집계 제외)
POST {{host}}/api/trips
Authorization: Bearer {{missionBToken}}
Content-Type: application/json

{
  "tripId": "{{$uuid}}",
  "startedAt": "{{today}}T07:00:00+09:00",
  "endedAt": "{{today}}T07:10:00+09:00",
  "distanceKm": 2.9,
  "supported": ["TURN_SIGNAL"],
  "events": [
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{today}}T07:02:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{today}}T07:05:00+09:00",
      "payload": { "direction": "RIGHT", "signalOn": true } },
    { "eventId": "{{$uuid}}", "type": "TURN", "occurredAt": "{{today}}T07:08:00+09:00",
      "payload": { "direction": "LEFT", "signalOn": true } }
  ]
}

> {%
    client.test("201 EXCLUDED_SHORT", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "EXCLUDED_SHORT", "status: " + response.body.status);
    });
%}

