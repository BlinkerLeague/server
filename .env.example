# 로컬 개발용 환경변수. 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.
# Spring(local 프로필)과 docker compose가 같은 .env를 읽는다.

# 생성: openssl rand -base64 48
JWT_SECRET=

# 로컬 PostgreSQL(docker compose가 이 값으로 DB를 만들고, 서버가 이 값으로 접속한다)
DB_NAME=blinkerleague
DB_USERNAME=blinkerleague
# 생성: openssl rand -hex 24
DB_PASSWORD=
