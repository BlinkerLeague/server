{
  "components": {
    "schemas": {
      "ConditionProgress": {
        "properties": {
          "current": {
            "format": "int32",
            "type": "integer"
          },
          "target": {
            "format": "int32",
            "type": "integer"
          },
          "type": {
            "enum": [
              "TURN_COUNT",
              "SIGNAL_RATE"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Description": {
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "score": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "EntryResponse": {
        "properties": {
          "amount": {
            "format": "int32",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/Description"
          },
          "reason": {
            "enum": [
              "TRIP",
              "DAILY_MISSION"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "EventRequest": {
        "properties": {
          "eventId": {
            "maxLength": 36,
            "minLength": 0,
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "description": "이벤트 타입별 추가 정보(선택). 서버는 해석하지 않고 JSON 그대로 저장한다. TURN: { \"direction\": \"LEFT\" | \"RIGHT\", \"signalOn\": true | false } (깜빡이 점수는 signalOn으로 계산한다). 다른 타입의 형식은 아직 정해지지 않아 저장만 한다.",
            "example": {
              "direction": "LEFT",
              "signalOn": true
            },
            "type": "object"
          },
          "type": {
            "enum": [
              "TURN",
              "LANE_CHANGE",
              "HARSH_ACCEL",
              "HARSH_BRAKE",
              "SAFETY_WARNING",
              "NIGHT_SEGMENT"
            ],
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "type"
        ],
        "type": "object"
      },
      "GradeRule": {
        "properties": {
          "grade": {
            "type": "string"
          },
          "minScore": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Harsh": {
        "properties": {
          "deltaKmhPerSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "MetricResult": {
        "properties": {
          "metric": {
            "enum": [
              "TURN_SIGNAL",
              "SMOOTH_DRIVING",
              "SAFETY_WARNING",
              "NIGHT_HEADLIGHT"
            ],
            "type": "string"
          },
          "score": {
            "format": "int32",
            "type": "integer"
          },
          "value": {
            "format": "double",
            "type": "number"
          },
          "weight": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "MissionResult": {
        "properties": {
          "missionId": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PlayItem": {
        "properties": {
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "result": {
            "enum": [
              "GOAL",
              "CONCEDED"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "TURN",
              "LANE_CHANGE",
              "HARSH_ACCEL",
              "HARSH_BRAKE",
              "SAFETY_WARNING",
              "NIGHT_SEGMENT"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Point": {
        "properties": {
          "dailyCap": {
            "format": "int32",
            "type": "integer"
          },
          "tripMaxKm": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PointsResponse": {
        "properties": {
          "balance": {
            "format": "int32",
            "type": "integer"
          },
          "dailyCap": {
            "format": "int32",
            "type": "integer"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryResponse"
            },
            "type": "array"
          },
          "todayEarned": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Progress": {
        "properties": {
          "requiredTurns": {
            "format": "int32",
            "type": "integer"
          },
          "successTurns": {
            "format": "int32",
            "type": "integer"
          },
          "turns": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "RecentTripResult": {
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "endedAt": {
            "format": "date-time",
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "score": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "enum": [
              "UPLOADED",
              "SCORED",
              "NO_TURN",
              "EXCLUDED_SHORT"
            ],
            "type": "string"
          },
          "tripId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegisterDriverRequest": {
        "properties": {
          "nickname": {
            "maxLength": 12,
            "minLength": 2,
            "type": "string"
          },
          "regionCode": {
            "pattern": "\\d{5}",
            "type": "string"
          }
        },
        "required": [
          "nickname",
          "regionCode"
        ],
        "type": "object"
      },
      "RegisterDriverResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "driverId": {
            "format": "int64",
            "type": "integer"
          },
          "nickname": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SafetyWarning": {
        "properties": {
          "mergeWindowSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "SummaryResult": {
        "properties": {
          "conceded": {
            "format": "int32",
            "type": "integer"
          },
          "fouls": {
            "format": "int32",
            "type": "integer"
          },
          "goals": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ThresholdsResponse": {
        "properties": {
          "grades": {
            "items": {
              "$ref": "#/components/schemas/GradeRule"
            },
            "type": "array"
          },
          "harsh": {
            "$ref": "#/components/schemas/Harsh"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "safetyWarning": {
            "$ref": "#/components/schemas/SafetyWarning"
          },
          "tips": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "trip": {
            "$ref": "#/components/schemas/Trip"
          },
          "turn": {
            "$ref": "#/components/schemas/Turn"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          },
          "weights": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "TodayMissionResponse": {
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/ConditionProgress"
            },
            "type": "array"
          },
          "missionId": {
            "format": "int64",
            "type": "integer"
          },
          "periodKey": {
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          },
          "rewardPoint": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "enum": [
              "IN_PROGRESS",
              "ACHIEVED",
              "FAILED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Trip": {
        "properties": {
          "minDistanceKm": {
            "format": "double",
            "type": "number"
          },
          "parkEndMinutes": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TripResult": {
        "properties": {
          "grade": {
            "type": "string"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricResult"
            },
            "type": "array"
          },
          "mission": {
            "$ref": "#/components/schemas/MissionResult"
          },
          "plays": {
            "items": {
              "$ref": "#/components/schemas/PlayItem"
            },
            "type": "array"
          },
          "score": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "enum": [
              "UPLOADED",
              "SCORED",
              "NO_TURN",
              "EXCLUDED_SHORT"
            ],
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/SummaryResult"
          },
          "tripId": {
            "type": "string"
          },
          "turns": {
            "$ref": "#/components/schemas/TurnsResult"
          }
        },
        "type": "object"
      },
      "Turn": {
        "properties": {
          "minAngleDeg": {
            "format": "int32",
            "type": "integer"
          },
          "minSpeedKmh": {
            "format": "int32",
            "type": "integer"
          },
          "signalLeadSec": {
            "format": "int32",
            "type": "integer"
          },
          "uTurnAngleDeg": {
            "format": "int32",
            "type": "integer"
          },
          "windowSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TurnsResult": {
        "properties": {
          "success": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "UploadTripRequest": {
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "endedAt": {
            "format": "date-time",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventRequest"
            },
            "type": "array"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "supported": {
            "items": {
              "enum": [
                "TURN_SIGNAL",
                "SMOOTH_DRIVING",
                "SAFETY_WARNING",
                "NIGHT_HEADLIGHT"
              ],
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "tripId": {
            "maxLength": 36,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "distanceKm",
          "endedAt",
          "events",
          "startedAt",
          "supported",
          "tripId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "깜빡이리그(BlinkerLeague) 차량 앱의 백엔드 API.\n\n- 인증: 보호된 API는 `Authorization: Bearer <accessToken>` 헤더가 필요하다.   토큰은 `POST /api/drivers`(등록)에서 처음 받고, Access 토큰(1시간)이 만료되면 `POST /api/auth/refresh`로 다시 받는다.\n- 토큰이 없으면 401 `UNAUTHORIZED`, 위조 · 만료된 토큰은 401 `INVALID_TOKEN`.\n- 오류 응답은 모두 `{ \"code\", \"message\" }` 형식이다. 앱은 `code`로 분기하고 `message`는 사용자 안내용이다.\n- 시각은 ISO-8601(오프셋 포함, 예: `2026-11-03T08:00:00+09:00`), 일 단위 집계는 Asia/Seoul 기준.\n",
    "title": "깜빡이리그 서버 API",
    "version": "P0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/auth/refresh": {
      "post": {
        "description": "Refresh 토큰을 본문으로 보내 새 Access · Refresh 토큰을 받는다. 보낸 Refresh 토큰은 무효가 되므로 응답의 새 토큰으로 바꿔 저장한다.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "새 Access · Refresh 토큰. 사용한 Refresh 토큰은 무효가 된다"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: refreshToken 누락"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_TOKEN: 없거나 만료 · 사용된 Refresh 토큰. 사용된 토큰을 다시 쓰면 그 운전자의 토큰 전체가 무효가 된다"
          }
        },
        "security": [],
        "summary": "토큰 재발급",
        "tags": [
          "인증"
        ]
      }
    },
    "/api/config/thresholds": {
      "get": {
        "description": "회전 · 급가감속 판정 기준, 점수 가중치, 포인트 규칙, 등급 기준, 항목별 팁 문구. 앱은 시작할 때 내려받고 version이 바뀐 경우에만 갱신한다.",
        "operationId": "thresholds",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThresholdsResponse"
                }
              }
            },
            "description": "현재 기준값과 version"
          }
        },
        "security": [],
        "summary": "판정 기준값 조회",
        "tags": [
          "설정"
        ]
      }
    },
    "/api/drivers": {
      "post": {
        "description": "닉네임과 거주 지역(시군구 5자리 코드)으로 운전자를 등록하고 Access · Refresh 토큰을 발급한다. 로그인 API는 없으며, 토큰을 잃으면 다시 등록한다(P0).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDriverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterDriverResponse"
                }
              }
            },
            "description": "등록 완료. Access · Refresh 토큰을 함께 발급한다"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: 닉네임 2~12자, 지역 코드는 시군구 5자리 숫자"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CONFLICT: 이미 사용 중인 닉네임"
          }
        },
        "security": [],
        "summary": "운전자 등록",
        "tags": [
          "운전자"
        ]
      }
    },
    "/api/missions/today": {
      "get": {
        "description": "오늘(Asia/Seoul) 운영 중인 일일 미션과 내 진행도. 운행 1건이 1라운드이고, 그날 라운드 중 하나라도 조건을 채우면 ACHIEVED로 확정된다. progress는 달성했으면 달성한 라운드, 아니면 가장 최근 라운드의 회전 수다. 최소 거리 미만 운행은 세지 않는다. 그날이 끝날 때까지 달성하지 못하면 FAILED이고, 오늘 첫 운행 전에는 마지막 미션 날의 최종 상태(ACHIEVED · FAILED)를 그 날의 periodKey로 보여 준다(D25).",
        "operationId": "today",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodayMissionResponse"
                }
              }
            },
            "description": "오늘의 미션과 진행도(status: IN_PROGRESS · ACHIEVED · FAILED). 오늘 운행 전이면 마지막 미션 날의 최종 상태"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NOT_FOUND: 오늘 운영 중인 미션이 없음"
          }
        },
        "summary": "오늘의 미션 조회",
        "tags": [
          "미션"
        ]
      }
    },
    "/api/points": {
      "get": {
        "description": "잔액(전체 적립 합계), 오늘(Asia/Seoul) 적립 합계와 일일 상한, 최근 원장 20건(최근 것부터). 운행 적립은 적립 당시의 거리 · 점수를 description에 담는다.",
        "operationId": "points",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PointsResponse"
                }
              }
            },
            "description": "잔액 · 오늘 적립 · 일일 상한 · 최근 원장"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "내 포인트 조회",
        "tags": [
          "포인트"
        ]
      }
    },
    "/api/trips": {
      "get": {
        "description": "내 운행을 종료 시각 최신순으로 돌려준다(SCR-01). limit은 기본 10, 최대 50이며 50을 넘으면 50건으로 자른다(D24). 점수가 없는 운행은 score · grade가 null이다.",
        "operationId": "recent",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecentTripResult"
                  },
                  "type": "array"
                }
              }
            },
            "description": "내 운행 목록(최신순)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
