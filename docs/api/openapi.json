          },
          "windowSec": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TurnsResult": {
        "properties": {
          "success": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "UploadTripRequest": {
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "endedAt": {
            "format": "date-time",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventRequest"
            },
            "type": "array"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "supported": {
            "items": {
              "enum": [
                "TURN_SIGNAL",
                "SMOOTH_DRIVING",
                "SAFETY_WARNING",
                "NIGHT_HEADLIGHT",
                "SIGNAL_CANCEL",
                "TURN_SPEED",
                "SEAT_BELT",
                "RAIN_DRIVING"
              ],
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "tripId": {
            "maxLength": 36,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "distanceKm",
          "endedAt",
          "events",
          "startedAt",
          "supported",
          "tripId"
        ],
        "type": "object"
      },
      "WeeklyReportView": {
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "lastMission": {
            "$ref": "#/components/schemas/MissionView"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricChange"
            },
            "type": "array"
          },
          "nextMission": {
            "$ref": "#/components/schemas/MissionView"
          },
          "trips": {
            "format": "int32",
            "type": "integer"
          },
          "weakestMetric": {
            "enum": [
              "TURN_SIGNAL",
              "SMOOTH_DRIVING",
              "SAFETY_WARNING",
              "NIGHT_HEADLIGHT",
              "SIGNAL_CANCEL",
              "TURN_SPEED",
              "SEAT_BELT",
              "RAIN_DRIVING"
            ],
            "type": "string"
          },
          "week": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "깜빡이리그(BlinkerLeague) 차량 앱의 백엔드 API.\n\n- 인증: 보호된 API는 `Authorization: Bearer <accessToken>` 헤더가 필요하다.   토큰은 `POST /api/drivers`(등록)에서 처음 받고, Access 토큰(1시간)이 만료되면 `POST /api/auth/refresh`로 다시 받는다.\n- 토큰이 없으면 401 `UNAUTHORIZED`, 위조 · 만료된 토큰은 401 `INVALID_TOKEN`.\n- 오류 응답은 모두 `{ \"code\", \"message\" }` 형식이다. 앱은 `code`로 분기하고 `message`는 사용자 안내용이다.\n- 시각은 ISO-8601(오프셋 포함, 예: `2026-11-03T08:00:00+09:00`), 일 단위 집계는 Asia/Seoul 기준.\n",
    "title": "깜빡이리그 서버 API",
    "version": "P0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/auth/refresh": {
      "post": {
        "description": "Refresh 토큰을 본문으로 보내 새 Access · Refresh 토큰을 받는다. 보낸 Refresh 토큰은 무효가 되므로 응답의 새 토큰으로 바꿔 저장한다.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "새 Access · Refresh 토큰. 사용한 Refresh 토큰은 무효가 된다"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: refreshToken 누락"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_TOKEN: 없거나 만료 · 사용된 Refresh 토큰. 사용된 토큰을 다시 쓰면 그 운전자의 토큰 전체가 무효가 된다"
          }
        },
        "security": [],
        "summary": "토큰 재발급",
        "tags": [
          "인증"
        ]
      }
    },
    "/api/badges": {
      "get": {
        "description": "전체 배지 카탈로그를 진열 순서로 돌려주고, 받은 배지는 earned=true와 받은 시각을 담는다(plan.md 4.3, SCR-05). 배지는 운행을 올릴 때 누적 기록(점수가 난 운행 수, 미션 최장 연속 달성 일수, 깜빡이를 켠 회전 수)으로 판정한다.",
        "operationId": "badges",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BadgeResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "전체 배지(code, name, condition, earned, awardedAt)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "배지 진열장 조회",
        "tags": [
          "배지"
        ]
      }
    },
    "/api/config/thresholds": {
      "get": {
        "description": "회전 · 급가감속 판정 기준, 점수 가중치, 포인트 규칙, 등급 기준, 항목별 팁 문구. 앱은 시작할 때 내려받고 version이 바뀐 경우에만 갱신한다.",
        "operationId": "thresholds",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThresholdsResponse"
                }
              }
            },
            "description": "현재 기준값과 version"
          }
        },
        "security": [],
        "summary": "판정 기준값 조회",
        "tags": [
          "설정"
        ]
      }
    },
    "/api/drivers": {
      "post": {
        "description": "닉네임과 거주 지역(시군구 5자리 코드)으로 운전자를 등록하고 Access · Refresh 토큰을 발급한다. 로그인 API는 없으며, 토큰을 잃으면 다시 등록한다(P0).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDriverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterDriverResponse"
                }
              }
            },
            "description": "등록 완료. Access · Refresh 토큰을 함께 발급한다"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: 닉네임 2~12자, 지역 코드는 시군구 5자리 숫자"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CONFLICT: 이미 사용 중인 닉네임"
          }
        },
        "security": [],
        "summary": "운전자 등록",
        "tags": [
          "운전자"
        ]
      }
    },
    "/api/drivers/me/league-visibility": {
      "put": {
        "description": "내 리그 순위 공개를 켜고 끈다(D8, SCR-08). 기본은 공개다. 끄면 순위 목록 · 지역 안전지수 · 시즌 보상에서 빠지고 내 순위도 보이지 않는다. 순위 공개 기준 인원(10명)에는 남아 다른 운전자의 순위는 계속 공개된다.",
        "operationId": "changeLeagueVisibility",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueVisibilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueVisibilityResponse"
                }
              }
            },
            "description": "바뀐 설정"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: visible 누락"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NOT_FOUND: 토큰의 운전자가 없음"
          }
        },
        "summary": "리그 순위 공개 설정",
        "tags": [
          "운전자"
        ]
      }
    },
    "/api/leagues/current": {
      "get": {
        "description": "이번 시즌(한국 시간 달력 월, D29)의 내 리그 권역 순위, 내 순위, 모든 권역의 지역 안전지수를 돌려준다(SCR-04). 순위 점수(score)는 공통 항목만으로 매긴 리그 점수(D19)의 거리 가중 평균(averageScore)에 시즌 안에 적립한 포인트(points)를 더한 값이다(D34). 지역 안전지수는 포인트 없이 리그 점수만으로 계산한다. 순위에는 시즌 누적 50km 또는 운행 10회 이상인 운전자만 오르고(D13), 리그 점수가 있는 참여자(순위 공개를 끈 운전자 포함)가 10명 미만인 권역은 순위를 공개하지 않는다(D11). 순위 공개를 끈 운전자는 순위 목록 · 안전지수에서 빠지고 나머지 운전자끼리 순위를 매긴다(D8). 시즌 1위 권역의 순위 자격자는 포인트 대신 우승 칭호(me.championships)와 시즌 우승 배지를 받는다(D30 · D34). 응답에는 닉네임만 담는다.",
        "operationId": "current",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentLeagueResponse"
                }
              }
            },
            "description": "이번 시즌 리그 현황. 등록 지역이 매핑표에 없으면 league는 null"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "이번 시즌 내 리그 조회",
        "tags": [
          "지역 리그"
        ]
      }
    },
    "/api/missions/today": {
      "get": {
        "description": "오늘(Asia/Seoul) 운영 중인 일일 미션과 내 진행도. 운행 1건이 1라운드이고, 그날 라운드 중 하나라도 조건을 채우면 ACHIEVED로 확정된다. progress는 달성했으면 달성한 라운드, 아니면 가장 최근 라운드의 회전 수다. 최소 거리 미만 운행은 세지 않는다. 그날이 끝날 때까지 달성하지 못하면 FAILED이고, 오늘 첫 운행 전에는 마지막 미션 날의 최종 상태(ACHIEVED · FAILED)를 그 날의 periodKey로 보여 준다(D25).",
        "operationId": "today",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodayMissionResponse"
                }
              }
            },
            "description": "오늘의 미션과 진행도(status: IN_PROGRESS · ACHIEVED · FAILED). 오늘 운행 전이면 마지막 미션 날의 최종 상태"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NOT_FOUND: 오늘 운영 중인 미션이 없음"
          }
        },
        "summary": "오늘의 미션 조회",
        "tags": [
          "미션"
        ]
      }
    },
    "/api/points": {
      "get": {
        "description": "잔액(전체 적립 합계), 오늘(Asia/Seoul) 적립 합계와 일일 상한, 최근 원장 20건(최근 것부터). 운행 적립은 적립 당시의 거리 · 점수를 description에 담는다.",
        "operationId": "points",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PointsResponse"
                }
              }
            },
            "description": "잔액 · 오늘 적립 · 일일 상한 · 최근 원장"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "내 포인트 조회",
        "tags": [
          "포인트"
        ]
      }
    },
    "/api/reports/weekly": {
      "get": {
        "description": "한 주(ISO 주, 월요일 시작, Asia/Seoul) 동안의 운전을 지난주와 비교한다(plan.md 4.5, SCR-07). metrics는 항목별 거리 가중 평균 점수(0~100)와 지난주 대비 변화, weakestMetric은 이번 주 가장 약한 항목이다. lastMission은 이 주에 수행한 맞춤 미션의 판정, nextMission은 가장 약한 항목으로 다음 주에 자동 등록한 맞춤 미션이다(수락 단계 없음, D7 B). 매주 월요일 04:00에 미리 만들어 두고, 없으면 조회할 때 만든다. 한 번 만든 리포트는 저장본을 그대로 돌려준다.",
        "operationId": "weekly",
        "parameters": [
          {
            "description": "ISO 주(예: 2026-W45). 없으면 지난주",
            "in": "query",
            "name": "week",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyReportView"
                }
              }
            },
            "description": "주간 리포트"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INVALID_INPUT: week 형식이 2026-W45가 아니거나 아직 끝나지 않은 주"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "주간 리포트 조회",
        "tags": [
          "리포트"
        ]
      }
    },
    "/api/streak": {
      "get": {
        "description": "일일 미션을 연속으로 달성한 일수(plan.md 4.3). 오늘 달성했으면 오늘부터, 아직이면 어제부터 거꾸로 센다(오늘 진행 중인 것은 끊김이 아님). 날짜는 Asia/Seoul 기준.",
        "operationId": "streak",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreakView"
                }
              }
            },
            "description": "streakDays(연속 달성 일수), todayAchieved(오늘 달성 여부)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: 토큰 없음 / INVALID_TOKEN: 위조 · 만료된 토큰"
          }
        },
        "summary": "연속 달성 조회",
        "tags": [
          "미션"
        ]
      }
    },
    "/api/trips": {
      "get": {
        "description": "내 운행을 종료 시각 최신순으로 돌려준다(SCR-01). limit은 기본 10, 최대 50이며 50을 넘으면 50건으로 자른다(D24). 점수가 없는 운행은 score · grade가 null이다.",
        "operationId": "recent",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecentTripResult"
                  },
                  "type": "array"
                }
              }
            },
            "description": "내 운행 목록(최신순)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
